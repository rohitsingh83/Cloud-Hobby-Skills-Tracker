rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidMedia() {
      // Must be under 5MB and valid media type
      return request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') 
            || request.resource.contentType == 'application/pdf');
    }

    // Profile photos
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if true; // Publicly viewable avatars
      allow write: if isOwner(userId) && isValidMedia();
    }

    // Practice achievement proof & certificates
    match /users/{userId}/skills/{skillId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isValidMedia();
    }

    // Community post media attachments
    match /posts/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidMedia();
    }
  }
}
